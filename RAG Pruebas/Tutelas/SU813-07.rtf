\rtlch\fcs1 \af0 \ltrch\fcs0 \cs28\lang9226\langfe3082\super\langnp9226\insrsid1655607 \chftn {\footnote \ltrpar \pard\plain \ltrpar\s29\qj \li0\ri0\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1655607 \rtlch\fcs1 
