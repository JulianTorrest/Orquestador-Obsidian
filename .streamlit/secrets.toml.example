# Streamlit secrets template.
# 1. Copy this file to .streamlit/secrets.toml
# 2. Replace the placeholder values with your real keys.
# 3. DO NOT commit secrets.toml to GitHub (it is already in .gitignore).
# 4. In Streamlit Cloud, paste these values in the dashboard instead.

OPENAI_API_KEY = "sk-..."
MISTRAL_API_KEY = "..."
DEFAULT_LLM = "openai"

LANGCHAIN_TRACING_V2 = "false"
LANGCHAIN_ENDPOINT = "https://api.smith.langchain.com"
LANGCHAIN_API_KEY = "..."
LANGCHAIN_PROJECT = "nexus_obsidian"
